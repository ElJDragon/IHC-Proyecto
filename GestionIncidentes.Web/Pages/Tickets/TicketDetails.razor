@page "/tickets/{id:guid}"
@using GestionIncidentes.Application.Interfaces
@using GestionIncidentes.Domain.Entities
@using MediatR
@inject ITicketRepository TicketRepo
@inject NavigationManager Navigation

<PageTitle>Detalles del Ticket</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (ticket == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Ticket no encontrado.
        </div>
        <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/tickets/my-tickets"))">
            <i class="bi bi-arrow-left"></i> Volver
        </button>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3><i class="bi bi-ticket-detailed"></i> @ticket.Title</h3>
                        <span class="badge @GetStatusBadgeClass(ticket.Status)">@ticket.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <h5>Descripción:</h5>
                            <p class="text-muted">@ticket.Description</p>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>ID:</strong> <code>@ticket.Id</code></p>
                                <p><strong>Creado por:</strong> @ticket.CreatedByUserId</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Asignado a:</strong> @(ticket.AssignedToUserId?.ToString() ?? "Sin asignar")</p>
                                <p><strong>Fecha de creación:</strong> @ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/tickets/my-tickets"))">
                            <i class="bi bi-arrow-left"></i> Volver
                        </button>
                    </div>
                </div>

                <!-- Timeline Component Placeholder -->
                <TicketTimeline TicketId="@Id" />
            </div>

            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header bg-info text-white">
                        <h5><i class="bi bi-info-circle"></i> Estado</h5>
                    </div>
                    <div class="card-body">
                        <TicketStatusBadge Status="@ticket.Status" />
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5><i class="bi bi-tools"></i> Acciones</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-warning" @onclick="@(() => UpdateStatus("InProgress"))">
                                <i class="bi bi-play-circle"></i> En Progreso
                            </button>
                            <button class="btn btn-success" @onclick="@(() => UpdateStatus("Resolved"))">
                                <i class="bi bi-check-circle"></i> Resolver
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Ticket? ticket;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ticket = await TicketRepo.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ticket: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateStatus(string newStatus)
    {
        if (ticket != null)
        {
            ticket.Status = newStatus;
            await TicketRepo.UpdateAsync(ticket);
            StateHasChanged();
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Open" => "bg-warning text-dark",
            "Assigned" => "bg-primary",
            "InProgress" => "bg-info text-dark",
            "Resolved" => "bg-success",
            "Closed" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}

@page "/tickets/my-tickets"
@using GestionIncidentes.Application.Features.Tickets.Queries
@using GestionIncidentes.Application.Features.Tickets.Dtos
@using GestionIncidentes.Application.Interfaces
@using MediatR
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Mis Tickets</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-ticket-perforated"></i> Mis Tickets Asignados</h2>
        <a href="/tickets/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Crear Ticket
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (tickets == null || !tickets.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No tienes tickets asignados.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var ticket in tickets)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@ticket.Title</h5>
                            <span class="badge @GetStatusBadgeClass(ticket.Status)">
                                @ticket.Status
                            </span>
                        </div>
                        <div class="card-body">
                            <p class="card-text text-muted">
                                @(ticket.Description.Length > 100 
                                    ? ticket.Description.Substring(0, 100) + "..." 
                                    : ticket.Description)
                            </p>
                            <hr />
                            <small class="text-muted">
                                <i class="bi bi-calendar"></i> @ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                        <div class="card-footer">
                            <a href="/tickets/@ticket.Id" class="btn btn-sm btn-primary w-100">
                                <i class="bi bi-eye"></i> Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-3">
            <div class="row">
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h3 class="text-warning">@tickets.Count(t => t.Status == "Open")</h3>
                            <p class="mb-0">Abiertos</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h3 class="text-primary">@tickets.Count(t => t.Status == "Assigned")</h3>
                            <p class="mb-0">Asignados</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h3 class="text-success">@tickets.Count(t => t.Status == "Resolved")</h3>
                            <p class="mb-0">Resueltos</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<TicketDto>? tickets;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = CurrentUser.UserId;
            if (userId.HasValue)
            {
                var query = new ListTicketsByAssigneeQuery(userId.Value);
                tickets = await Mediator.Send(query);
            }
            else
            {
                tickets = new List<TicketDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tickets: {ex.Message}");
            tickets = new List<TicketDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Open" => "bg-warning text-dark",
            "Assigned" => "bg-primary",
            "InProgress" => "bg-info text-dark",
            "Resolved" => "bg-success",
            "Closed" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}

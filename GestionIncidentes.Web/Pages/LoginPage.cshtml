@page
@model GestionIncidentes.Web.Pages.LoginPageModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Sistema de Incidentes</title>
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="brand-logo">
                    <span class="brand-icon">SI</span>
                </div>
                <h1 class="login-title">Sistema de Incidentes</h1>
                <p class="login-subtitle">Universidad Técnica de Ambato</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert-error">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post" class="login-form">
                <div class="form-group">
                    <label for="email">Correo Institucional</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="Email"
                        value="@Model.Email"
                        placeholder="ejemplo@uta.edu.ec"
                        required />
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="Password"
                        placeholder="••••••••"
                        required />
                </div>

                <button type="submit" class="btn-login">
                    <span>Iniciar Sesión</span>
                </button>
            </form>

            <div class="demo-section">
                <div class="demo-title">Usuarios de prueba</div>
                <div class="demo-grid">
                    <div class="demo-user">
                        <strong>Admin:</strong> Admin@uta.edu.ec / Admin123
                    </div>
                    <div class="demo-user">
                        <strong>Técnico 1:</strong> Tec1@uta.edu.ec / 123456
                    </div>
                    <div class="demo-user">
                        <strong>Técnico 2:</strong> Tec2@uta.edu.ec / 654321
                    </div>
                    <div class="demo-user">
                        <strong>Usuario 1:</strong> User1@uta.edu.ec / 12456
                    </div>
                    <div class="demo-user">
                        <strong>Usuario 2:</strong> User2@uta.edu.ec / 654321
                    </div>
                </div>
            </div>

            <div class="login-footer">
                <p>¿Necesitas ayuda? Contacta a <a href="mailto:soporte@uta.edu.ec">soporte@uta.edu.ec</a></p>
            </div>
        </div>
    </div>
</body>
</html>

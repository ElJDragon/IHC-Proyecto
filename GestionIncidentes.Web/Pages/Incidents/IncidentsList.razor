@page "/incidents"
@using GestionIncidentes.Application.Features.Incidents.Queries
@using GestionIncidentes.Application.Features.Incidents.Dtos
@using MediatR
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Lista de Incidentes</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-list-ul"></i> Incidentes Reportados</h2>
        <a href="/incidents/report" class="btn btn-danger">
            <i class="bi bi-plus-circle"></i> Reportar Incidente
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (incidents == null || !incidents.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay incidentes reportados.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Estado</th>
                                <th>Título</th>
                                <th>Descripción</th>
                                <th>Reportado</th>
                                <th>Ticket</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var incident in incidents)
                            {
                                <tr>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(incident.Status)">
                                            @incident.Status
                                        </span>
                                    </td>
                                    <td><strong>@incident.Title</strong></td>
                                    <td>
                                        @(incident.Description.Length > 50 
                                            ? incident.Description.Substring(0, 50) + "..." 
                                            : incident.Description)
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @incident.ReportedAt.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </td>
                                    <td>
                                        @if (incident.AssignedTicketId.HasValue)
                                        {
                                            <a href="/tickets/@incident.AssignedTicketId" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-ticket"></i> Ver Ticket
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/incidents/@incident.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <p class="text-muted">
                <i class="bi bi-info-circle"></i> Total de incidentes: <strong>@incidents.Count</strong>
            </p>
        </div>
    }
</div>

@code {
    private List<IncidentDto>? incidents;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var query = new ListIncidentsQuery();
            incidents = await Mediator.Send(query);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading incidents: {ex.Message}");
            incidents = new List<IncidentDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Reported" => "bg-warning text-dark",
            "InProgress" => "bg-primary",
            "Resolved" => "bg-success",
            _ => "bg-secondary"
        };
    }
}

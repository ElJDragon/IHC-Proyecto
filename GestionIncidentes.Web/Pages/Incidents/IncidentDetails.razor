@page "/incidents/{id:guid}"
@using GestionIncidentes.Application.Features.Incidents.Queries
@using GestionIncidentes.Application.Features.Incidents.Dtos
@using MediatR
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Detalles del Incidente</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (incident == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Incidente no encontrado.
        </div>
        <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/incidents"))">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </button>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3><i class="bi bi-file-earmark-text"></i> @incident.Title</h3>
                        <span class="badge @GetStatusBadgeClass(incident.Status)">@incident.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <h5>Descripción:</h5>
                            <p class="text-muted">@incident.Description</p>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>ID:</strong> <code>@incident.Id</code></p>
                                <p><strong>Reportado por:</strong> @incident.ReportedByUserId</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Fecha:</strong> @incident.ReportedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                @if (incident.AssignedTicketId.HasValue)
                                {
                                    <p><strong>Ticket Asignado:</strong> 
                                        <a href="/tickets/@incident.AssignedTicketId">@incident.AssignedTicketId</a>
                                    </p>
                                }
                                else
                                {
                                    <p class="text-warning"><i class="bi bi-info-circle"></i> Sin ticket asignado</p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/incidents"))">
                            <i class="bi bi-arrow-left"></i> Volver
                        </button>
                        @if (!incident.AssignedTicketId.HasValue)
                        {
                            <button class="btn btn-primary ms-2" @onclick="CreateTicket">
                                <i class="bi bi-plus-circle"></i> Crear Ticket
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5><i class="bi bi-info-circle"></i> Información</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <small class="text-muted">Estado del Incidente:</small>
                            <div class="mt-1">
                                <span class="badge @GetStatusBadgeClass(incident.Status) w-100">@incident.Status</span>
                            </div>
                        </div>
                        <hr />
                        <small class="text-muted">
                            Un incidente es un evento que interrumpe el funcionamiento normal del servicio.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private IncidentDto? incident;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var query = new GetIncidentDetailsQuery(Id);
            incident = await Mediator.Send(query);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading incident: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Reported" => "bg-warning text-dark",
            "InProgress" => "bg-primary",
            "Resolved" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private void CreateTicket()
    {
        Navigation.NavigateTo($"/tickets/create?incidentId={Id}");
    }
}

@* Componente: Timeline de acciones del ticket *@
@using GestionIncidentes.Application.Interfaces
@using GestionIncidentes.Domain.Entities
@inject IAuditLogRepository AuditLogRepo

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5><i class="bi bi-clock-history"></i> Historial de Acciones</h5>
    </div>
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center">
                <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (auditLogs == null || !auditLogs.Any())
        {
            <p class="text-muted"><i class="bi bi-info-circle"></i> No hay acciones registradas.</p>
        }
        else
        {
            <div class="timeline">
                @foreach (var log in auditLogs.OrderByDescending(l => l.Timestamp))
                {
                    <div class="timeline-item mb-3">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="bi bi-circle-fill text-primary"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <p class="mb-1"><strong>@log.Action</strong></p>
                                <small class="text-muted">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                @if (!string.IsNullOrEmpty(log.Details))
                                {
                                    <p class="mb-0 mt-1 text-muted">@log.Details</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid TicketId { get; set; }

    private List<AuditLog>? auditLogs;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allLogs = await AuditLogRepo.GetAllAsync();
            auditLogs = allLogs.Where(l => l.EntityId == TicketId).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading audit logs: {ex.Message}");
            auditLogs = new List<AuditLog>();
        }
        finally
        {
            isLoading = false;
        }
    }
}

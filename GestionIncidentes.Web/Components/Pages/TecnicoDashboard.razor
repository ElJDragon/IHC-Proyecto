@page "/tecnico/dashboard"
@layout TecnicoLayout
@rendermode InteractiveServer
@inject GestionIncidentes.Web.Services.TechnicianTicketService TicketService
@using GestionIncidentes.Application.Models

<link rel="stylesheet" href="/css/pages.css" />
<link rel="stylesheet" href="/css/tecnico.css" />

<div class="page-shell">
    <div class="page-header">
        <h1 class="page-title">Mis Tickets Asignados</h1>
        <p class="page-subtitle">@myTickets.Count(t => t.Status != "Resuelto") tickets pendientes</p>
    </div>

    @if (loading)
    {
        <div style="text-align:center; padding:40px">Cargando tickets...</div>
    }
    else
    {
        <div class="tickets-shell">
            <div class="tickets-list">
                <div class="list-title">Ordenados por SLA (urgencia)</div>

                @foreach (var ticket in myTickets.OrderBy(t => t.SlaDeadline))
                {
                    <div class="ticket-item @(selectedTicketId == ticket.Id ? "selected" : "")" @onclick="() => SelectTicket(ticket.Id)">
                        <div class="header">
                            <div class="title">@ticket.TicketNumber</div>
                            <div class="badge @GetPriorityClass(ticket.Priority)">@GetPriorityLabel(ticket.Priority)</div>
                        </div>
                        <div class="meta">
                            <span>@ticket.Title</span>
                            <span>@ticket.Location @(string.IsNullOrEmpty(ticket.LocationDetail) ? "" : $"- {ticket.LocationDetail}")</span>
                            <span>SLA: @CalculateSLA(ticket.SlaDeadline)</span>
                        </div>
                        <div class="progress"><div class="bar" style="width:@CalculateProgress(ticket)%"></div></div>
                    </div>
                }

                @if (myTickets.Count == 0)
                {
                    <div style="text-align:center; padding:40px; color:var(--text-gray)">No tienes tickets asignados</div>
                }
            </div>

            @if (selectedTicket != null)
            {
                <div class="ticket-detail">
                    <div class="title">@selectedTicket.TicketNumber <span class="badge @GetPriorityClass(selectedTicket.Priority)">Prioridad @GetPriorityLabel(selectedTicket.Priority)</span></div>
                    <div class="divider"></div>
                    <div class="meta" style="gap:24px; color:var(--text-gray)">
                        <span>Ubicación: @selectedTicket.Location</span>
                        @if (!string.IsNullOrEmpty(selectedTicket.LocationDetail))
                        {
                            <span>Detalle: @selectedTicket.LocationDetail</span>
                        }
                        <span>Reportado por: @selectedTicket.CreatedByName</span>
                    </div>

                    <div style="margin:16px 0; padding:16px; background:var(--bg-secondary); border-radius:8px">
                        <div style="font-weight:600; margin-bottom:8px">Descripción:</div>
                        <div>@selectedTicket.Description</div>
                    </div>

                    <div class="actions">
                        <div class="action-card">
                            <div style="font-weight:600; margin-bottom:8px">Cambiar Estado</div>
                            <select @bind="newStatus" class="form-select">
                                <option value="">Seleccionar</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="En proceso">En proceso</option>
                                <option value="Resuelto">Resuelto</option>
                            </select>
                            <button class="btn-primary" style="margin-top:8px" @onclick="ChangeStatus" disabled="@string.IsNullOrEmpty(newStatus)">Aplicar</button>
                        </div>
                    </div>

                    <div class="log-card">
                        <div style="font-weight:600; margin-bottom:8px">Bitácora de Solución</div>
                        <textarea @bind="technicianNotes" class="form-control" rows="5" placeholder="Describe los pasos realizados para resolver el problema..."></textarea>
                        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:12px">
                            <button class="btn-secondary" @onclick="SaveNotes" disabled="@string.IsNullOrEmpty(technicianNotes)">Guardar Notas</button>
                            <button class="btn-primary" @onclick="CloseTicket" disabled="@(selectedTicket.Status == "Resuelto")">Cerrar Ticket</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="ticket-detail" style="display:flex; align-items:center; justify-content:center; color:var(--text-gray)">
                    Selecciona un ticket para ver los detalles
                </div>
            }
        </div>
    }
</div>

@code {
    private List<TicketResponseDto> myTickets = new();
    private TicketResponseDto? selectedTicket = null;
    private Guid? selectedTicketId = null;
    private bool loading = true;
    private string newStatus = "";
    private string technicianNotes = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTicketsAsync();
    }

    private async Task LoadTicketsAsync()
    {
        loading = true;
        try
        {
            myTickets = await TicketService.GetMyTicketsAsync() ?? new List<TicketResponseDto>();
            if (myTickets.Any())
            {
                selectedTicketId = myTickets.First().Id;
                await SelectTicket(selectedTicketId.Value);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tickets: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SelectTicket(Guid ticketId)
    {
        selectedTicketId = ticketId;
        selectedTicket = await TicketService.GetTicketAsync(ticketId);
        technicianNotes = selectedTicket?.TechnicianNotes ?? "";
        newStatus = "";
    }

    private async Task ChangeStatus()
    {
        if (selectedTicket == null || string.IsNullOrEmpty(newStatus)) return;
        
        try
        {
            await TicketService.ChangeStatusAsync(selectedTicket.Id, new ChangeTicketStatusDto(newStatus, null));
            await LoadTicketsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error changing status: {ex.Message}");
        }
    }

    private async Task SaveNotes()
    {
        if (selectedTicket == null) return;
        
        try
        {
            await TicketService.UpdateNotesAsync(selectedTicket.Id, technicianNotes);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving notes: {ex.Message}");
        }
    }

    private async Task CloseTicket()
    {
        if (selectedTicket == null) return;
        
        try
        {
            await TicketService.CloseTicketAsync(selectedTicket.Id, new CloseTicketDto(technicianNotes, null));
            await LoadTicketsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error closing ticket: {ex.Message}");
        }
    }

    private string GetPriorityClass(string priority) => priority?.ToLower() switch
    {
        "critical" => "critica",
        "high" => "alta",
        "medium" => "media",
        "low" => "baja",
        _ => "media"
    };
    
    private string GetPriorityLabel(string priority) => priority?.ToLower() switch
    {
        "critical" => "Crítica",
        "high" => "Alta",
        "medium" => "Media",
        "low" => "Baja",
        _ => priority ?? "Media"
    };
    
    private string CalculateSLA(DateTime? deadline)
    {
        if (deadline == null) return "-";
        var remaining = deadline.Value - DateTime.UtcNow;
        if (remaining.TotalHours < 0) return "Vencido";
        if (remaining.TotalHours < 24) return $"{(int)remaining.TotalHours}h";
        return $"{(int)remaining.TotalDays}d";
    }
    
    private int CalculateProgress(TicketResponseDto ticket)
    {
        if (ticket.SlaDeadline == null) return 0;
        var total = (ticket.SlaDeadline.Value - ticket.CreatedAt).TotalMinutes;
        var elapsed = (DateTime.UtcNow - ticket.CreatedAt).TotalMinutes;
        return Math.Min(100, (int)((elapsed / total) * 100));
    }
}

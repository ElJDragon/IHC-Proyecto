@page "/tecnico/dashboard"
@layout TecnicoLayout
@rendermode InteractiveServer
@inject GestionIncidentes.Web.Services.TechnicianTicketService TicketService
@using GestionIncidentes.Application.Models

<link rel="stylesheet" href="/css/pages.css" />

<div>
    <div style="margin-bottom: 1.5rem;">
        <h1>Mis Tickets Asignados</h1>
        <p style="color: var(--color-text-secondary); margin-top: 0.25rem;">Gestiona los tickets que te han sido asignados</p>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-3" style="margin-bottom: 1.5rem; gap: 1rem;">
        <div class="card">
            <div style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 0.25rem;">Pendientes</div>
            <div style="font-size: 32px; font-weight: 600; color: var(--color-warning);">@myTickets.Count(t => t.Status == "Abierto")</div>
            <div style="font-size: 12px; color: var(--color-text-tertiary); margin-top: 0.5rem;">Requieren atención</div>
        </div>
        <div class="card">
            <div style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 0.25rem;">En Proceso</div>
            <div style="font-size: 32px; font-weight: 600; color: #1976d2;">@myTickets.Count(t => t.Status == "En Progreso")</div>
            <div style="font-size: 12px; color: var(--color-text-tertiary); margin-top: 0.5rem;">Trabajando en ellos</div>
        </div>
        <div class="card">
            <div style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 0.25rem;">Resueltos Hoy</div>
            <div style="font-size: 32px; font-weight: 600; color: var(--color-success);">@myTickets.Count(t => t.Status == "Resuelto" && t.ResolvedAt.HasValue && t.ResolvedAt.Value.Date == DateTime.Today)</div>
            <div style="font-size: 12px; color: var(--color-text-tertiary); margin-top: 0.5rem;">Completados</div>
        </div>
    </div>

    @if (loading)
    {
        <div class="empty-state">
            <p>Cargando tickets...</p>
        </div>
    }
    else
    {
        <!-- Tickets List -->
        <div>
            <h3 style="margin-bottom: 1rem;">Tickets Activos</h3>

            @if (!myTickets.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg style="width: 40px; height: 40px; color: var(--color-text-tertiary);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                    <h3>No tienes tickets asignados</h3>
                    <p style="color: var(--color-text-secondary); margin-top: 0.5rem;">Cuando se te asignen tickets, aparecerán aquí</p>
                </div>
            }
            else
            {
                @foreach (var ticket in myTickets.OrderByDescending(t => t.Priority).ThenBy(t => t.CreatedAt))
                {
                    <div class="ticket-card" @onclick="() => SelectTicket(ticket.Id)">
                        <div class="ticket-header">
                            <div class="ticket-id">@ticket.TicketNumber</div>
                            <span class="ticket-status @GetStatusClass(ticket.Status)">@ticket.Status</span>
                        </div>
                        <div class="ticket-title">@ticket.Description</div>
                        <div class="ticket-meta">
                            <span>📍 @ticket.LocationDetail</span>
                            <span>⏱️ @GetTimeAgo(ticket.CreatedAt)</span>
                            <span>@GetPriorityEmoji(ticket.Priority) Prioridad: @GetPriorityLabel(ticket.Priority)</span>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<TicketResponseDto> myTickets = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTicketsAsync();
    }

    private async Task LoadTicketsAsync()
    {
        loading = true;
        try
        {
            myTickets = await TicketService.GetMyTicketsAsync() ?? new List<TicketResponseDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tickets: {ex.Message}");
            myTickets = new List<TicketResponseDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private void SelectTicket(Guid ticketId)
    {
        // Navigate to detail page or show modal
        // For now, just log it
        Console.WriteLine($"Selected ticket: {ticketId}");
    }

    private string GetStatusClass(string status) => status switch
    {
        "Abierto" => "status-pending",
        "En Progreso" => "status-in-progress",
        "Resuelto" => "status-resolved",
        _ => "status-pending"
    };

    private string GetPriorityLabel(string priority) => priority?.ToLower() switch
    {
        "critical" => "Crítica",
        "high" => "Alta",
        "medium" => "Media",
        "low" => "Baja",
        _ => priority ?? "Media"
    };

    private string GetPriorityEmoji(string priority) => priority?.ToLower() switch
    {
        "critical" => "🔴",
        "high" => "🟠",
        "medium" => "🔵",
        "low" => "🟢",
        _ => "🔵"
    };

    private string GetTimeAgo(DateTime date)
    {
        var timeSpan = DateTime.Now - date;
        if (timeSpan.TotalMinutes < 60)
            return $"Hace {(int)timeSpan.TotalMinutes} min";
        if (timeSpan.TotalHours < 24)
            return $"Hace {(int)timeSpan.TotalHours}h";
        return $"Hace {(int)timeSpan.TotalDays}d";
    }
}

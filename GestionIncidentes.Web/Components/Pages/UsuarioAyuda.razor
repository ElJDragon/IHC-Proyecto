@page "/usuario/ayuda"
@layout UsuarioLayout
@rendermode InteractiveServer

<link rel="stylesheet" href="/css/pages.css" />

<div class="page-shell">
  <div class="page-header" style="text-align:center">
    <span class="material-icons" style="font-size:48px; color:var(--color-primary); margin-bottom:8px">help_outline</span>
    <h1 class="page-title">Ayuda y Guías</h1>
    <p class="page-subtitle">Documentación y soporte para usuarios</p>
  </div>

  <div class="card" style="max-width:600px; margin:0 auto; padding:48px; text-align:center">
    <span class="material-icons" style="font-size:64px; color:#e5e7eb; margin-bottom:16px">construction</span>
    <h3>Sección en desarrollo</h3>
    <p style="color:var(--text-gray); margin-top:12px">Aquí encontrarás guías, tutoriales y preguntas frecuentes para resolver problemas técnicos.</p>
  </div>
</div>

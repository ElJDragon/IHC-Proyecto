@page "/usuario/configuracion"
@layout UsuarioLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JSRuntime

<PageTitle>Configuración - Usuario</PageTitle>

<link rel="stylesheet" href="/css/pages.css" />

<div class="page-shell">
    <!-- Breadcrumbs -->
    <nav style="margin-bottom: 24px; color: var(--text-gray); font-size: 14px">
        <span>Inicio</span>
        <span style="margin: 0 8px">&gt;</span>
        <span>Usuario</span>
        <span style="margin: 0 8px">&gt;</span>
        <span style="color: var(--color-primary)">Configuración</span>
    </nav>

    <!-- Page Header -->
    <div class="page-header" style="margin-bottom: 32px">
        <h1>⚙️ Configuración</h1>
        <p style="color: var(--text-gray); margin-top: 4px">Personaliza la apariencia y comportamiento de la aplicación</p>
    </div>

    <!-- Settings Cards -->
    <div style="display: grid; gap: 24px; max-width: 900px">
        
        <!-- Tema -->
        <div class="card">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px">
                <span class="material-icons" style="color: var(--color-primary); font-size: 28px">palette</span>
                <div>
                    <h2 style="font-size: 20px; font-weight: 600; margin: 0; color: var(--text-dark)">Apariencia</h2>
                    <p style="font-size: 14px; color: var(--text-gray); margin: 4px 0 0">Modo de visualización de la interfaz</p>
                </div>
            </div>
            
            <div style="display: grid; gap: 12px">
                <div class="setting-option @(theme == "light" ? "selected" : "")" @onclick='() => SetTheme("light")'>
                    <div style="display: flex; align-items: center; gap: 12px">
                        <span class="material-icons" style="font-size: 24px">light_mode</span>
                        <div style="flex: 1">
                            <div style="font-weight: 600; font-size: 15px">Modo Claro</div>
                            <div style="font-size: 13px; color: var(--text-gray)">Interfaz con fondo claro y texto oscuro</div>
                        </div>
                        @if (theme == "light")
                        {
                            <span class="material-icons" style="color: var(--color-primary)">check_circle</span>
                        }
                    </div>
                </div>

                <div class="setting-option @(theme == "dark" ? "selected" : "")" @onclick='() => SetTheme("dark")'>
                    <div style="display: flex; align-items: center; gap: 12px">
                        <span class="material-icons" style="font-size: 24px">dark_mode</span>
                        <div style="flex: 1">
                            <div style="font-weight: 600; font-size: 15px">Modo Oscuro</div>
                            <div style="font-size: 13px; color: var(--text-gray)">Reduce el brillo en ambientes con poca luz</div>
                        </div>
                        @if (theme == "dark")
                        {
                            <span class="material-icons" style="color: var(--color-primary)">check_circle</span>
                        }
                    </div>
                </div>

                <div class="setting-option @(theme == "auto" ? "selected" : "")" @onclick='() => SetTheme("auto")'>
                    <div style="display: flex; align-items: center; gap: 12px">
                        <span class="material-icons" style="font-size: 24px">brightness_auto</span>
                        <div style="flex: 1">
                            <div style="font-weight: 600; font-size: 15px">Automático</div>
                            <div style="font-size: 13px; color: var(--text-gray)">Se adapta según las preferencias del sistema</div>
                        </div>
                        @if (theme == "auto")
                        {
                            <span class="material-icons" style="color: var(--color-primary)">check_circle</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Tipografía -->
        <div class="card">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px">
                <span class="material-icons" style="color: var(--color-primary); font-size: 28px">text_fields</span>
                <div>
                    <h2 style="font-size: 20px; font-weight: 600; margin: 0; color: var(--text-dark)">Tipografía</h2>
                    <p style="font-size: 14px; color: var(--text-gray); margin: 4px 0 0">Ajusta el tamaño del texto</p>
                </div>
            </div>

            <div style="margin-bottom: 20px">
                <label style="display: block; font-weight: 500; margin-bottom: 12px; color: var(--text-dark)">
                    Tamaño de letra: <span style="color: var(--color-primary); font-weight: 600">@fontSize%</span>
                </label>
                <input type="range" min="80" max="140" step="10" @bind="fontSize" @bind:event="oninput" @bind:after="ApplyFontSize"
                       style="width: 100%; cursor: pointer" />
                <div style="display: flex; justify-content: space-between; margin-top: 8px; font-size: 12px; color: var(--text-gray)">
                    <span>80% - Pequeño</span>
                    <span>100% - Normal</span>
                    <span>140% - Grande</span>
                </div>
            </div>

            <div style="padding: 16px; background: var(--bg-secondary); border-radius: 8px; border: 1px solid var(--border-color)">
                <div style="font-size: @(fontSize * 0.14)px; color: var(--text-gray); margin-bottom: 4px">Vista previa del texto</div>
                <div style="font-size: @(fontSize * 0.16)px; font-weight: 500; color: var(--text-dark)">Este es el aspecto del texto con el tamaño seleccionado</div>
            </div>
        </div>

        <!-- Accesibilidad -->
        <div class="card">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px">
                <span class="material-icons" style="color: var(--color-primary); font-size: 28px">accessibility_new</span>
                <div>
                    <h2 style="font-size: 20px; font-weight: 600; margin: 0; color: var(--text-dark)">Accesibilidad</h2>
                    <p style="font-size: 14px; color: var(--text-gray); margin: 4px 0 0">Opciones para mejorar la visualización</p>
                </div>
            </div>

            <div style="display: grid; gap: 12px">
                <div class="setting-option @(colorBlindMode == "none" ? "selected" : "")" @onclick='() => SetColorBlindMode("none")'>
                    <div style="display: flex; align-items: center; gap: 12px">
                        <span class="material-icons" style="font-size: 24px">visibility</span>
                        <div style="flex: 1">
                            <div style="font-weight: 600; font-size: 15px">Visión Normal</div>
                            <div style="font-size: 13px; color: var(--text-gray)">Colores estándar del sistema</div>
                        </div>
                        @if (colorBlindMode == "none")
                        {
                            <span class="material-icons" style="color: var(--color-primary)">check_circle</span>
                        }
                    </div>
                </div>

                <div class="setting-option @(colorBlindMode == "protanopia" ? "selected" : "")" @onclick='() => SetColorBlindMode("protanopia")'>
                    <div style="display: flex; align-items: center; gap: 12px">
                        <span class="material-icons" style="font-size: 24px">remove_red_eye</span>
                        <div style="flex: 1">
                            <div style="font-weight: 600; font-size: 15px">Protanopia (Rojo-Verde)</div>
                            <div style="font-size: 13px; color: var(--text-gray)">Dificultad para distinguir rojo y verde</div>
                        </div>
                        @if (colorBlindMode == "protanopia")
                        {
                            <span class="material-icons" style="color: var(--color-primary)">check_circle</span>
                        }
                    </div>
                </div>

                <div class="setting-option @(colorBlindMode == "deuteranopia" ? "selected" : "")" @onclick='() => SetColorBlindMode("deuteranopia")'>
                    <div style="display: flex; align-items: center; gap: 12px">
                        <span class="material-icons" style="font-size: 24px">remove_red_eye</span>
                        <div style="flex: 1">
                            <div style="font-weight: 600; font-size: 15px">Deuteranopia (Verde-Rojo)</div>
                            <div style="font-size: 13px; color: var(--text-gray)">Dificultad para distinguir verde y rojo</div>
                        </div>
                        @if (colorBlindMode == "deuteranopia")
                        {
                            <span class="material-icons" style="color: var(--color-primary)">check_circle</span>
                        }
                    </div>
                </div>

                <div class="setting-option @(colorBlindMode == "tritanopia" ? "selected" : "")" @onclick='() => SetColorBlindMode("tritanopia")'>
                    <div style="display: flex; align-items: center; gap: 12px">
                        <span class="material-icons" style="font-size: 24px">remove_red_eye</span>
                        <div style="flex: 1">
                            <div style="font-weight: 600; font-size: 15px">Tritanopia (Azul-Amarillo)</div>
                            <div style="font-size: 13px; color: var(--text-gray)">Dificultad para distinguir azul y amarillo</div>
                        </div>
                        @if (colorBlindMode == "tritanopia")
                        {
                            <span class="material-icons" style="color: var(--color-primary)">check_circle</span>
                        }
                    </div>
                </div>
            </div>

            <div style="margin-top: 16px; padding: 12px 16px; background: var(--color-info-light); border-left: 4px solid var(--color-info); border-radius: 6px">
                <div style="display: flex; align-items: start; gap: 8px">
                    <span class="material-icons" style="font-size: 20px; color: var(--color-info)">info</span>
                    <div style="font-size: 13px; color: var(--text-dark)">
                        Los modos de daltonismo ajustan la paleta de colores para mejorar la distinción entre elementos de la interfaz.
                    </div>
                </div>
            </div>
        </div>

        <!-- Botón de Resetear -->
        <div class="card" style="background: var(--bg-secondary)">
            <button @onclick="ResetSettings" class="btn-secondary" style="width: 100%">
                <span class="material-icons">restart_alt</span>
                <span>Restaurar configuración por defecto</span>
            </button>
        </div>
    </div>
</div>

<style>
.setting-option {
    padding: 16px;
    border: 2px solid var(--border-color);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s;
    background: white;
}

.setting-option:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
}

.setting-option.selected {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
}

input[type="range"] {
    -webkit-appearance: none;
    height: 6px;
    border-radius: 3px;
    background: var(--border-color);
    outline: none;
}

input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    cursor: pointer;
}

input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    cursor: pointer;
    border: none;
}
</style>

@code {
    private string theme = "light";
    private int fontSize = 100;
    private string colorBlindMode = "none";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSettings();
            StateHasChanged();
        }
    }

    private async Task LoadSettings()
    {
        try
        {
            theme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "theme") ?? "light";
            var fontSizeStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "fontSize");
            fontSize = int.TryParse(fontSizeStr, out var fs) ? fs : 100;
            colorBlindMode = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "colorBlindMode") ?? "none";
            
            await ApplyAllSettings();
        }
        catch
        {
            // Si falla, usar valores por defecto
        }
    }

    private async Task SetTheme(string newTheme)
    {
        theme = newTheme;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "theme", theme);
        
        await JSRuntime.InvokeVoidAsync("eval", $@"
            const theme = '{theme}';
            if (theme === 'dark') {{
                document.documentElement.classList.add('dark-theme');
            }} else if (theme === 'light') {{
                document.documentElement.classList.remove('dark-theme');
            }} else {{
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (prefersDark) {{
                    document.documentElement.classList.add('dark-theme');
                }} else {{
                    document.documentElement.classList.remove('dark-theme');
                }}
            }}
        ");
    }

    private async Task ApplyFontSize()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "fontSize", fontSize.ToString());
        await JSRuntime.InvokeVoidAsync("eval", $"document.documentElement.style.setProperty('--base-font-size', '{fontSize}%')");
    }

    private async Task SetColorBlindMode(string mode)
    {
        colorBlindMode = mode;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "colorBlindMode", colorBlindMode);
        await ApplyColorBlindMode();
    }

    private async Task ApplyColorBlindMode()
    {
        await JSRuntime.InvokeVoidAsync("eval", $@"
            const root = document.documentElement;
            root.classList.remove('colorblind-protanopia', 'colorblind-deuteranopia', 'colorblind-tritanopia');
            if ('{colorBlindMode}' !== 'none') {{
                root.classList.add('colorblind-{colorBlindMode}');
            }}
        ");
    }

    private async Task ApplyAllSettings()
    {
        await SetTheme(theme);
        await ApplyFontSize();
        await ApplyColorBlindMode();
    }

    private async Task ResetSettings()
    {
        theme = "light";
        fontSize = 100;
        colorBlindMode = "none";
        
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "theme", theme);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "fontSize", "100");
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "colorBlindMode", "none");
        
        await ApplyAllSettings();
        
        await JSRuntime.InvokeVoidAsync("alert", "✅ Configuración restaurada a valores por defecto");
    }
}

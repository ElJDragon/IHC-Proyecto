@page "/usuario/mis-reportes"
@using GestionIncidentes.Domain.Entities
@using GestionIncidentes.Application.Interfaces
@rendermode InteractiveServer

<PageTitle>Mis Reportes - Gestión de Incidentes</PageTitle>

<div class="mis-reportes-container">
    <div class="page-header">
        <div>
            <h2>📋 Mis Reportes</h2>
            <p class="subtitle">Historial de incidentes reportados</p>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📊</div>
            <div class="stat-content">
                <div class="stat-label">Total Reportes</div>
                <div class="stat-value">@allTickets.Count</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">✅</div>
            <div class="stat-content">
                <div class="stat-label">Resueltos</div>
                <div class="stat-value">@allTickets.Count(t => t.Status == "Resuelto")</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⏳</div>
            <div class="stat-content">
                <div class="stat-label">Activos</div>
                <div class="stat-value">@allTickets.Count(t => t.Status != "Resuelto")</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⏱️</div>
            <div class="stat-content">
                <div class="stat-label">Tiempo Promedio</div>
                <div class="stat-value">@CalculateAverageResolutionTime()</div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filters-section">
        <div class="search-box">
            <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterTickets" placeholder="🔍 Buscar por título, descripción o categoría..." class="search-input" />
        </div>
        <div class="filter-buttons">
            <button class="filter-btn @(selectedStatus == "" ? "active" : "")" @onclick="@(() => FilterByStatus(""))">
                Todos (@allTickets.Count)
            </button>
            <button class="filter-btn filter-abierto @(selectedStatus == "Abierto" ? "active" : "")" @onclick="@(() => FilterByStatus("Abierto"))">
                Abierto (@allTickets.Count(t => t.Status == "Abierto"))
            </button>
            <button class="filter-btn filter-enprogreso @(selectedStatus == "En Progreso" ? "active" : "")" @onclick="@(() => FilterByStatus("En Progreso"))">
                En Progreso (@allTickets.Count(t => t.Status == "En Progreso"))
            </button>
            <button class="filter-btn filter-resuelto @(selectedStatus == "Resuelto" ? "active" : "")" @onclick="@(() => FilterByStatus("Resuelto"))">
                Resuelto (@allTickets.Count(t => t.Status == "Resuelto"))
            </button>
            @if (!string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrEmpty(selectedStatus))
            {
                <button class="filter-btn-clear" @onclick="ClearFilters">✖️ Limpiar filtros</button>
            }
        </div>
    </div>

    <!-- Lista de Tickets -->
    @if (filteredTickets.Any())
    {
        <div class="tickets-grid">
            @foreach (var ticket in filteredTickets)
            {
                <div class="ticket-card" @onclick="() => ViewTicketDetails(ticket.Id)">
                    <div class="ticket-header">
                        <div class="ticket-category">
                            <span class="category-icon">@GetCategoryIcon(ticket.Category)</span>
                            <span>@ticket.Category</span>
                        </div>
                        <span class="ticket-status status-@ticket.Status.ToLower().Replace(" ", "-")">
                            @ticket.Status
                        </span>
                    </div>
                    <h4 class="ticket-title">@ticket.Title</h4>
                    <p class="ticket-description">@ticket.Description</p>
                    <div class="ticket-meta">
                        <div class="meta-item">
                            <span class="meta-icon">📅</span>
                            <span>@ticket.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-icon">📍</span>
                            <span>@ticket.Location</span>
                        </div>
                        @if (ticket.ResolvedAt.HasValue)
                        {
                            <div class="meta-item">
                                <span class="meta-icon">✅</span>
                                <span>Resuelto: @ticket.ResolvedAt.Value.ToString("dd/MM/yyyy")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <h3>@GetEmptyStateMessage()</h3>
            <p>@GetEmptyStateDescription()</p>
        </div>
    }
</div>

<style>
.mis-reportes-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.page-header h2 {
    font-size: 2rem;
    color: var(--color-text-primary);
    margin: 0;
}

.subtitle {
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: var(--border-radius-lg);
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
}

.stat-icon {
    font-size: 2.5rem;
}

.stat-content {
    flex: 1;
}

.stat-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.25rem;
}

.stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
}

.filters-section {
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: var(--border-radius-lg);
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
}

.search-box {
    margin-bottom: 1rem;
}

.search-input {
    width: 100%;
    padding: 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    font-size: 1rem;
    transition: all 0.2s;
}

.search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.filter-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.filter-btn {
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--color-border);
    background: white;
    color: var(--color-text-primary);
    border-radius: var(--border-radius-full);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
}

.filter-btn:hover {
    background: var(--color-background);
}

.filter-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
}

.filter-abierto.active {
    background: var(--color-warning);
    border-color: var(--color-warning);
}

.filter-enprogreso.active {
    background: var(--color-info);
    border-color: var(--color-info);
}

.filter-resuelto.active {
    background: var(--color-success);
    border-color: var(--color-success);
}

.filter-btn-clear {
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--color-critical);
    background: white;
    color: var(--color-critical);
    border-radius: var(--border-radius-full);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
}

.tickets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
}

.ticket-card {
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition: all 0.2s;
    border: 1px solid var(--color-border);
}

.ticket-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
}

.ticket-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.ticket-category {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
}

.category-icon {
    font-size: 1.25rem;
}

.ticket-status {
    padding: 0.25rem 0.75rem;
    border-radius: var(--border-radius-full);
    font-size: 0.75rem;
    font-weight: 600;
}

.status-abierto {
    background: #FEF3C7;
    color: #92400E;
}

.status-en-progreso {
    background: #DBEAFE;
    color: #1E40AF;
}

.status-resuelto {
    background: #D1FAE5;
    color: #065F46;
}

.ticket-title {
    font-size: 1.125rem;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
}

.ticket-description {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.ticket-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.813rem;
    color: var(--color-text-secondary);
}

.meta-icon {
    font-size: 1rem;
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
}

.empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.empty-state h3 {
    font-size: 1.5rem;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
}

.empty-state p {
    color: var(--color-text-secondary);
    margin: 0;
}

@@media (max-width: 768px) {
    .mis-reportes-container {
        padding: 1rem;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .tickets-grid {
        grid-template-columns: 1fr;
    }

    .filter-buttons {
        flex-direction: column;
    }

    .filter-btn {
        width: 100%;
    }
}
</style>

@code {
    [Inject] private ITicketRepository TicketRepo { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private Guid currentUserId = Guid.Parse("11111111-1111-1111-1111-111111111111");
    private List<Ticket> allTickets = new();
    private List<Ticket> filteredTickets = new();
    private string searchTerm = string.Empty;
    private string selectedStatus = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTickets();
    }

    private async Task LoadTickets()
    {
        allTickets = await TicketRepo.GetByCreatedByUserIdAsync(currentUserId);
        filteredTickets = allTickets;
    }

    private void FilterTickets()
    {
        filteredTickets = allTickets;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            filteredTickets = filteredTickets.Where(t =>
                t.Title.ToLower().Contains(search) ||
                t.Description.ToLower().Contains(search) ||
                t.Category.ToLower().Contains(search)
            ).ToList();
        }

        if (!string.IsNullOrEmpty(selectedStatus))
        {
            filteredTickets = filteredTickets.Where(t => t.Status == selectedStatus).ToList();
        }
    }

    private void FilterByStatus(string status)
    {
        selectedStatus = status;
        FilterTickets();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStatus = string.Empty;
        FilterTickets();
    }

    private void ViewTicketDetails(Guid ticketId)
    {
        Nav.NavigateTo($"/ticket/{ticketId}");
    }

    private string GetCategoryIcon(string category)
    {
        return category switch
        {
            "Hardware" => "🖥️",
            "Software" => "💻",
            "Red" => "🌐",
            _ => "❓"
        };
    }

    private string GetEmptyStateMessage()
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
            return "No se encontraron resultados";
        if (!string.IsNullOrEmpty(selectedStatus))
            return $"No tienes reportes con estado '{selectedStatus}'";
        return "No has reportado ningún incidente";
    }

    private string GetEmptyStateDescription()
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
            return "Intenta con otros términos de búsqueda";
        if (!string.IsNullOrEmpty(selectedStatus))
            return "Prueba seleccionando otro estado";
        return "Cuando reportes un incidente, aparecerá aquí";
    }

    private string CalculateAverageResolutionTime()
    {
        var resolved = allTickets.Where(t => t.Status == "Resuelto" && t.ResolvedAt.HasValue).ToList();
        if (!resolved.Any()) return "N/A";

        var avgHours = resolved.Average(t => (t.ResolvedAt!.Value - t.CreatedAt).TotalHours);
        if (avgHours < 24)
            return $"{(int)avgHours}h";
        return $"{(int)(avgHours / 24)}d";
    }
}

@page "/admin/incidentes"
@layout AdminLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject GestionIncidentes.Web.Services.AdminTicketService TicketService
@using GestionIncidentes.Application.Models

<link rel="stylesheet" href="/css/pages.css" />

<div>
  <!-- Breadcrumbs -->
  <div class="breadcrumbs">
    <span>Inicio</span>
    <svg style="width: 16px; height: 16px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
    <span style="color: var(--color-text-primary);">Incidentes</span>
  </div>

  <!-- Page Header with Action Button -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
      <h1>Gestión de Incidentes</h1>
      <p style="color: var(--color-text-secondary); margin-top: 0.25rem;">Administra todos los tickets del sistema</p>
    </div>
    <button class="btn-primary" @onclick="NavigateToNewTicket">
      <svg style="width: 20px; height: 20px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Nuevo Incidente
    </button>
  </div>

  <!-- Tabs -->
  <div class="tabs">
    <button class="tab @(selectedTab == "all" ? "active" : "")" @onclick='() => selectedTab = "all"'>
      Todos (@allTickets.Count)
    </button>
    <button class="tab @(selectedTab == "open" ? "active" : "")" @onclick='() => selectedTab = "open"'>
      Abiertos (@allTickets.Count(t => t.Status == "Abierto"))
    </button>
    <button class="tab @(selectedTab == "in-progress" ? "active" : "")" @onclick='() => selectedTab = "in-progress"'>
      En Proceso (@allTickets.Count(t => t.Status == "En Progreso"))
    </button>
    <button class="tab @(selectedTab == "resolved" ? "active" : "")" @onclick='() => selectedTab = "resolved"'>
      Resueltos (@allTickets.Count(t => t.Status == "Resuelto"))
    </button>
  </div>

  <!-- Filters -->
  <div class="filters-bar">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <svg style="width: 16px; height: 16px; color: var(--color-text-tertiary);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
      <span style="font-size: 14px; font-weight: 500;">Filtros:</span>
    </div>
    
    <select @bind="filterPrioridad" class="filter-select">
      <option value="all">Todas las prioridades</option>
      <option value="critical">Crítica</option>
      <option value="high">Alta</option>
      <option value="medium">Media</option>
      <option value="low">Baja</option>
    </select>
    
    <select @bind="filterLaboratorio" class="filter-select">
      <option value="all">Todos los laboratorios</option>
      <option value="Lab 1">Lab 1</option>
      <option value="Lab 2">Lab 2</option>
      <option value="Lab 3">Lab 3</option>
      <option value="Lab 4">Lab 4</option>
      <option value="Lab 5">Lab 5</option>
    </select>
    
    <select @bind="filterTecnico" class="filter-select">
      <option value="all">Todos los técnicos</option>
      <option value="Carlos Méndez">Carlos Méndez</option>
      <option value="Ana Torres">Ana Torres</option>
      <option value="Luis García">Luis García</option>
    </select>
  </div>

  <!-- Incidents List -->
  <div id="incidentsList">
    @if (loading)
    {
      <div class="empty-state">
        <p>Cargando incidentes...</p>
      </div>
    }
    else if (!GetFilteredTickets().Any())
    {
      <div class="empty-state">
        <div class="empty-icon">
          <svg style="width: 40px; height: 40px; color: var(--color-text-tertiary);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <h3>No se encontraron incidentes</h3>
        <p style="color: var(--color-text-secondary); margin-top: 0.5rem;">Intenta ajustar los filtros</p>
      </div>
    }
    else
    {
      @foreach (var ticket in GetFilteredTickets())
      {
        <div class="incident-card">
          <div class="incident-header">
            <span class="incident-id">@ticket.TicketNumber</span>
            <span class="incident-priority @GetPriorityBadgeClass(ticket.Priority)">@GetPrioridadLabel(ticket.Priority)</span>
          </div>
          <h3 class="incident-title">@ticket.Description</h3>
          <p class="incident-description">
            @if (!string.IsNullOrEmpty(ticket.TechnicianNotes))
            {
              @ticket.TechnicianNotes
            }
            else
            {
              <text>Problema reportado el @ticket.CreatedAt.ToString("dd/MM/yyyy")</text>
            }
          </p>
          <div class="incident-meta">
            <span>📍 @ticket.LocationDetail</span>
            <span>⏱️ @GetTimeAgo(ticket.CreatedAt)</span>
            <span>📅 @ticket.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
          </div>
          <div class="incident-footer">
            <div class="assignee">
              @if (!string.IsNullOrEmpty(ticket.AssignedToName))
              {
                <div class="assignee-avatar">@GetInitials(ticket.AssignedToName)</div>
                <div>
                  <div style="font-size: 14px; font-weight: 500;">@ticket.AssignedToName</div>
                  <div style="font-size: 12px; color: var(--color-text-tertiary);">@ticket.Status</div>
                </div>
              }
              else
              {
                <div style="font-size: 14px; color: var(--color-text-tertiary);">Sin asignar</div>
              }
            </div>
            <span class="badge @GetStatusBadgeClass(ticket.Status)">@ticket.Status</span>
          </div>
        </div>
      }
    }
  </div>
</div>

@code {
  private string selectedTab = "all";
  private string filterTecnico = "all";
  private string filterLaboratorio = "all";
  private string filterPrioridad = "all";
  private List<TicketResponseDto> allTickets = new List<TicketResponseDto>();
  private bool loading = true;

  protected override async Task OnInitializedAsync()
  {
    await LoadTicketsAsync();
  }

  private async Task LoadTicketsAsync()
  {
    loading = true;
    try
    {
      allTickets = await TicketService.ListTicketsAsync(null) ?? new List<TicketResponseDto>();
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error loading tickets: {ex.Message}");
      allTickets = new List<TicketResponseDto>();
    }
    finally
    {
      loading = false;
    }
  }

  private List<TicketResponseDto> GetFilteredTickets()
  {
    var filtered = allTickets.AsEnumerable();

    // Filtrar por tab
    if (selectedTab != "all")
    {
      filtered = selectedTab switch
      {
        "open" => filtered.Where(t => t.Status == "Abierto"),
        "in-progress" => filtered.Where(t => t.Status == "En Progreso"),
        "resolved" => filtered.Where(t => t.Status == "Resuelto"),
        _ => filtered
      };
    }

    // Aplicar filtros adicionales
    filtered = filtered.Where(t =>
      (filterTecnico == "all" || (t.AssignedToName ?? "").Contains(filterTecnico)) &&
      (filterLaboratorio == "all" || (t.LocationDetail ?? "").Contains(filterLaboratorio)) &&
      (filterPrioridad == "all" || t.Priority == filterPrioridad)
    );

    return filtered.ToList();
  }

  private void NavigateToNewTicket()
  {
    Navigation.NavigateTo("/admin/nuevo-incidente");
  }

  private string GetPriorityBadgeClass(string prioridad) => prioridad?.ToLower() switch
  {
    "critical" => "badge-critical",
    "high" or "alta" => "badge-warning",
    "medium" or "media" => "badge-info",
    "low" or "baja" => "badge-success",
    _ => "badge-info"
  };

  private string GetStatusBadgeClass(string status) => status switch
  {
    "Resuelto" => "badge-success",
    "En Progreso" => "badge-info",
    "Abierto" => "badge-warning",
    _ => "badge-info"
  };

  private string GetPrioridadLabel(string prioridad) => prioridad?.ToLower() switch
  {
    "critical" => "Crítica",
    "high" => "Alta",
    "medium" => "Media",
    "low" => "Baja",
    _ => prioridad ?? "Media"
  };

  private string GetInitials(string name)
  {
    if (string.IsNullOrEmpty(name)) return "??";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    if (parts.Length >= 2)
      return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
  }

  private string GetTimeAgo(DateTime date)
  {
    var timeSpan = DateTime.Now - date;
    if (timeSpan.TotalMinutes < 60)
      return $"Hace {(int)timeSpan.TotalMinutes} min";
    if (timeSpan.TotalHours < 24)
      return $"Hace {(int)timeSpan.TotalHours}h";
    return $"Hace {(int)timeSpan.TotalDays}d";
  }
}



@page "/perfil"
@using GestionIncidentes.Domain.Entities
@using GestionIncidentes.Application.Interfaces
@rendermode InteractiveServer

<PageTitle>Mi Perfil - Gestión de Incidentes</PageTitle>

<div class="perfil-container">
    <h2>👤 Mi Perfil</h2>

    @if (currentUser != null)
    {
        <!-- Información Personal -->
        <div class="profile-card">
            <div class="card-header">
                <h3>📋 Información Personal</h3>
                @if (!editMode)
                {
                    <button class="btn-edit" @onclick="EnableEdit">✏️ Editar</button>
                }
            </div>

            <div class="profile-content">
                <div class="profile-avatar">
                    <div class="avatar-circle">
                        @GetUserInitials(currentUser.FullName)
                    </div>
                    <div>
                        <h4>@currentUser.FullName</h4>
                        <span class="role-badge">@GetRoleIcon(currentUser.Role) @currentUser.Role</span>
                    </div>
                </div>

                @if (editMode)
                {
                    <div class="form-section">
                        <div class="form-group">
                            <label>Nombre Completo</label>
                            <input type="text" @bind="editFullName" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" @bind="editEmail" class="form-input" />
                        </div>
                        <div class="button-group">
                            <button class="btn-primary" @onclick="SaveProfile">💾 Guardar Cambios</button>
                            <button class="btn-secondary" @onclick="CancelEdit">❌ Cancelar</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">📧 Email</span>
                            <span class="info-value">@currentUser.Email</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">🏢 Rol</span>
                            <span class="info-value">@currentUser.Role</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Cambiar Contraseña -->
        <div class="profile-card">
            <div class="card-header">
                <h3>🔒 Seguridad</h3>
            </div>
            <div class="profile-content">
                @if (!showPasswordForm)
                {
                    <button class="btn-secondary" @onclick="() => showPasswordForm = true">
                        🔑 Cambiar contraseña
                    </button>
                }
                else
                {
                    <div class="form-section">
                        <div class="form-group">
                            <label>Contraseña Actual</label>
                            <input type="password" @bind="currentPassword" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Nueva Contraseña</label>
                            <input type="password" @bind="newPassword" class="form-input" />
                            @if (!string.IsNullOrEmpty(newPassword))
                            {
                                <div class="password-strength">
                                    <div class="strength-bar strength-@GetPasswordStrength()"></div>
                                    <span class="strength-text">@GetPasswordStrengthText()</span>
                                </div>
                            }
                        </div>
                        <div class="form-group">
                            <label>Confirmar Nueva Contraseña</label>
                            <input type="password" @bind="confirmPassword" class="form-input" />
                        </div>
                        <div class="button-group">
                            <button class="btn-primary" @onclick="ChangePassword" disabled="@(!IsPasswordFormValid())">
                                💾 Guardar Contraseña
                            </button>
                            <button class="btn-secondary" @onclick="CancelPasswordForm">
                                ❌ Cancelar
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Configuración -->
        <div class="profile-card">
            <div class="card-header">
                <h3>⚙️ Configuración</h3>
            </div>
            <div class="profile-content">
                <div class="settings-list">
                    <a href="/configuracion/accesibilidad" class="setting-item">
                        <div class="setting-info">
                            <span class="setting-icon">🎨</span>
                            <div>
                                <div class="setting-name">Accesibilidad</div>
                                <div class="setting-desc">Tema, colores y opciones visuales</div>
                            </div>
                        </div>
                        <span class="chevron">→</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Zona de Peligro -->
        <div class="profile-card danger-zone">
            <div class="card-header">
                <h3>⚠️ Zona de Peligro</h3>
            </div>
            <div class="profile-content">
                <button class="btn-danger" @onclick="Logout">
                    🚪 Cerrar Sesión
                </button>
            </div>
        </div>
    }
</div>

<style>
.perfil-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
}

.perfil-container h2 {
    font-size: 2rem;
    color: var(--color-text-primary);
    margin-bottom: 2rem;
}

.profile-card {
    background: var(--color-surface);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.5rem;
    overflow: hidden;
}

.card-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.card-header h3 {
    font-size: 1.25rem;
    color: var(--color-text-primary);
    margin: 0;
}

.profile-content {
    padding: 1.5rem;
}

.profile-avatar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.avatar-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
}

.profile-avatar h4 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    color: var(--color-text-primary);
}

.role-badge {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    background: var(--color-background);
    color: var(--color-primary);
    border-radius: var(--border-radius-full);
    font-size: 0.875rem;
    font-weight: 500;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.info-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-weight: 500;
}

.info-value {
    font-size: 1rem;
    color: var(--color-text-primary);
}

.form-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-primary);
}

.form-input {
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    font-size: 1rem;
    transition: border-color 0.2s;
}

.form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.button-group {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
}

.btn-edit, .btn-primary, .btn-secondary, .btn-danger {
    padding: 0.625rem 1.25rem;
    border-radius: var(--border-radius-md);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-size: 0.875rem;
}

.btn-edit, .btn-primary {
    background: var(--color-primary);
    color: white;
}

.btn-edit:hover, .btn-primary:hover {
    background: var(--color-primary-dark);
}

.btn-primary:disabled {
    background: var(--color-border);
    cursor: not-allowed;
}

.btn-secondary {
    background: var(--color-background);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
}

.btn-secondary:hover {
    background: var(--color-surface);
}

.btn-danger {
    background: var(--color-critical);
    color: white;
}

.btn-danger:hover {
    background: #b91c1c;
}

.password-strength {
    margin-top: 0.5rem;
}

.strength-bar {
    height: 4px;
    border-radius: 2px;
    transition: all 0.3s;
    margin-bottom: 0.25rem;
}

.strength-bar.strength-weak {
    width: 33%;
    background: var(--color-critical);
}

.strength-bar.strength-medium {
    width: 66%;
    background: var(--color-warning);
}

.strength-bar.strength-strong {
    width: 100%;
    background: var(--color-success);
}

.strength-text {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
}

.settings-list {
    display: flex;
    flex-direction: column;
}

.setting-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-radius: var(--border-radius-md);
    transition: background 0.2s;
    text-decoration: none;
    color: inherit;
}

.setting-item:hover {
    background: var(--color-background);
}

.setting-info {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.setting-icon {
    font-size: 1.5rem;
}

.setting-name {
    font-weight: 500;
    color: var(--color-text-primary);
}

.setting-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
}

.chevron {
    color: var(--color-text-secondary);
    font-size: 1.25rem;
}

.danger-zone {
    border: 1px solid #FEE2E2;
}

.danger-zone .card-header {
    background: #FEF2F2;
    border-bottom-color: #FEE2E2;
}

@@media (max-width: 768px) {
    .perfil-container {
        padding: 1rem;
    }

    .profile-avatar {
        flex-direction: column;
        text-align: center;
    }

    .info-grid {
        grid-template-columns: 1fr;
    }

    .button-group {
        flex-direction: column;
    }
}
</style>

@code {
    [Inject] private IUserRepository UserRepo { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private User? currentUser;
    private bool editMode = false;
    private string editFullName = string.Empty;
    private string editEmail = string.Empty;

    private bool showPasswordForm = false;
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;

    private Guid currentUserId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        currentUser = await UserRepo.GetByIdAsync(currentUserId);
    }

    private void EnableEdit()
    {
        editMode = true;
        editFullName = currentUser?.FullName ?? "";
        editEmail = currentUser?.Email ?? "";
    }

    private void CancelEdit()
    {
        editMode = false;
        editFullName = string.Empty;
        editEmail = string.Empty;
    }

    private async Task SaveProfile()
    {
        if (currentUser != null)
        {
            currentUser.SetFullName(editFullName);
            await UserRepo.UpdateAsync(currentUser);
            editMode = false;
        }
    }

    private bool IsPasswordFormValid()
    {
        return !string.IsNullOrWhiteSpace(currentPassword) &&
               !string.IsNullOrWhiteSpace(newPassword) &&
               newPassword == confirmPassword &&
               newPassword.Length >= 8;
    }

    private async Task ChangePassword()
    {
        if (currentUser != null && IsPasswordFormValid())
        {
            currentUser.SetPassword(newPassword);
            await UserRepo.UpdateAsync(currentUser);
            showPasswordForm = false;
            currentPassword = "";
            newPassword = "";
            confirmPassword = "";
        }
    }

    private void CancelPasswordForm()
    {
        showPasswordForm = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
    }

    private string GetPasswordStrength()
    {
        if (newPassword.Length < 8) return "weak";
        if (newPassword.Length < 12) return "medium";
        return "strong";
    }

    private string GetPasswordStrengthText()
    {
        return GetPasswordStrength() switch
        {
            "weak" => "Débil",
            "medium" => "Media",
            "strong" => "Fuerte",
            _ => ""
        };
    }

    private void Logout()
    {
        Nav.NavigateTo("/", true);
    }

    private string GetUserInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }

    private string GetRoleIcon(string role)
    {
        return role switch
        {
            "Administrador" => "👑",
            "Tecnico" => "🔧",
            "Usuario" => "👤",
            _ => "❓"
        };
    }
}

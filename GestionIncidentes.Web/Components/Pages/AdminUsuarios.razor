                    <button class="action-btn delete" title="Eliminar"><span class="material-icons">delete</span></button>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="user-avatar">MT</div>
                        <div class="user-info">
                            <p class="user-name">Miguel Torres</p>
                            <p class="user-email">miguel.torres@universidad.edu</p>
                        </div>
                    </div>
                </td>
                <td><span class="badge badge-tech">Técnico</span></td>
                <td>Soporte Técnico</td>
                <td><span class="status-badge active">Activo</span></td>
                <td>4/4/2023</td>
                <td>
                    <button class="action-btn edit" title="Editar"><span class="material-icons">edit</span></button>
                    <button class="action-btn delete" title="Eliminar"><span class="material-icons">delete</span></button>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="user-avatar">AM</div>
                        <div class="user-info">
                            <p class="user-name">Ana Martínez</p>
                            <p class="user-email">ana.martinez@universidad.edu</p>
                        </div>
                    </div>
                </td>
                <td><span class="badge badge-user">Usuario</span></td>
                <td>Administración</td>
                <td><span class="status-badge active">Activo</span></td>
                <td>11/5/2023</td>

                    <button class="action-btn delete" title="Eliminar"><span class="material-icons">delete</span></button>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="user-avatar">CL</div>
                        <div class="user-info">
                            <p class="user-name">Carmen López</p>
                            <p class="user-email">carmen.lopez@universidad.edu</p>
                        </div>
                    </div>
                </td>
                <td><span class="badge badge-tech">Técnico</span></td>
                <td>Soporte Técnico</td>
                <td><span class="status-badge inactive">Inactivo</span></td>
                <td>7/11/2022</td>
                <td>
                    <button class="action-btn edit" title="Editar"><span class="material-icons">edit</span></button>
                    <button class="action-btn delete" title="Eliminar"><span class="material-icons">delete</span></button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<div class="user-stats">
    <div class="stat-card">
        <div class="stat-icon admin"><span class="material-icons">shield</span></div>
        <div class="stat-content">
            <p class="stat-label">Administradores</p>
            <p class="stat-value">1</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon tech"><span class="material-icons">engineering</span></div>
        <div class="stat-content">
            <p class="stat-label">Técnicos</p>
            <p class="stat-value">3</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon user"><span class="material-icons">person</span></div>
        <div class="stat-content">
            <p class="stat-label">Usuarios</p>
            <p class="stat-value">2</p>
        </div>
    </div>
</div>


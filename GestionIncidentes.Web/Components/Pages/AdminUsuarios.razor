@page "/admin/usuarios"
@layout AdminLayout

<link rel="stylesheet" href="/css/pages.css" />
<link rel="stylesheet" href="/css/usuarios.css" />

<div class="usuarios-header">
    <div class="header-content">
        <h1 class="page-title">Gestión de Usuarios</h1>
        <p class="page-subtitle">6 usuarios encontrados</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowNewUserModal">
        <span class="material-icons">add</span>
        Nuevo Usuario
    </button>
</div>

<div class="filters-section">
    <div class="search-box">
        <span class="material-icons">search</span>
        <input type="text" class="search-input" placeholder="Buscar usuarios..." />
    </div>
    <select class="filter-select">
        <option>Todos los roles</option>
        <option>Administrador</option>
        <option>Técnico</option>
        <option>Usuario</option>
    </select>
    <select class="filter-select">
        <option>Todos los estados</option>
        <option>Activo</option>
        <option>Inactivo</option>
    </select>
</div>

<div class="usuarios-table">
    <table>
        <thead>
            <tr>
                <th>USUARIO</th>
                <th>ROL</th>
                <th>DEPARTAMENTO</th>
                <th>ESTADO</th>
                <th>FECHA DE INGRESO</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="user-avatar">CR</div>
                        <div class="user-info">
                            <p class="user-name">Carlos Rodríguez</p>
                            <p class="user-email">carlos.rodriguez@universidad.edu</p>
                        </div>
                    </div>
                </td>
                <td><span class="badge badge-admin">Administrador</span></td>
                <td>TI</td>
                <td><span class="status-badge active">Activo</span></td>
                <td>14/1/2023</td>
                <td>
                    <button class="action-btn edit" title="Editar"><span class="material-icons">edit</span></button>
                    <button class="action-btn" title="Más opciones"><span class="material-icons">more_vert</span></button>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="user-avatar">MG</div>
                        <div class="user-info">
                            <p class="user-name">María González</p>
                            <p class="user-email">maria.gonzalez@universidad.edu</p>
                        </div>
                    </div>
                </td>
                <td><span class="badge badge-user">Usuario</span></td>
                <td>Facultad de Ingeniería</td>
                <td><span class="status-badge active">Activo</span></td>
                <td>19/3/2023</td>
                <td>
                    <button class="action-btn edit" title="Editar"><span class="material-icons">edit</span></button>
                    <button class="action-btn delete" title="Eliminar"><span class="material-icons">delete</span></button>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="user-avatar">LF</div>
                        <div class="user-info">
                            <p class="user-name">Laura Fernández</p>
                            <p class="user-email">laura.fernandez@universidad.edu</p>
                        </div>
                    </div>
                </td>
                <td><span class="badge badge-tech">Técnico</span></td>
                <td>Soporte Técnico</td>
                <td><span class="status-badge active">Activo</span></td>
                <td>9/2/2023</td>
                <td>

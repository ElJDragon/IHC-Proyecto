@page "/usuario/dashboard"
@layout UsuarioLayout
@rendermode InteractiveServer
@inject GestionIncidentes.Web.Services.StudentReportService ReportService
@using GestionIncidentes.Application.Models

<link rel="stylesheet" href="/css/pages.css" />
<link rel="stylesheet" href="/css/usuario.css" />

<div class="page-shell">
    <div class="page-header" style="text-align:center; display:flex; justify-content:space-between; align-items:center; max-width:900px; margin:0 auto 20px;">
        <div style="flex:1">
            <h1 class="page-title">Mis Reportes</h1>
            <p class="page-subtitle">Historial de incidentes reportados</p>
        </div>
        <button @onclick="RefreshData" class="btn-secondary" style="display:flex; align-items:center; gap:8px;">
            <span class="material-icons" style="font-size:20px">refresh</span>
            Recargar
        </button>
    </div>

    @if (loading)
    {
        <div style="text-align:center; padding:40px">Cargando reportes...</div>
    }
    else
    {
        <div class="grid-cards" style="max-width:900px; margin:0 auto 24px">
            <div class="card">
                <div class="card-title">Tickets abiertos</div>
                <div class="card-value">@myReports.Count(r => r.Status != "Resuelto")</div>
                <div class="card-desc">En espera de atención</div>
            </div>
            <div class="card">
                <div class="card-title">Total reportados</div>
                <div class="card-value">@myReports.Count</div>
                <div class="card-desc">Historial completo</div>
            </div>
        </div>

        <div class="table-shell" style="max-width:900px; margin:0 auto">
            <div class="table-title">Tus Incidentes</div>
            @if (myReports.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Problema</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in myReports.OrderByDescending(r => r.CreatedAt))
                        {
                            <tr>
                                <td><strong>@report.TicketNumber</strong></td>
                                <td>@report.Title</td>
                                <td>@report.CreatedAt.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="text-align:center; padding:40px; color:var(--text-gray)">
                    <div style="font-size: 48px; margin-bottom: 16px;">📭</div>
                    <h3 style="margin-bottom: 8px;">No has reportado ningún incidente aún</h3>
                    <p style="margin-bottom: 16px;">Cuando reportes un incidente, aparecerá aquí</p>
                    <a href="/usuario/reportar" class="btn-primary" style="display: inline-block; padding: 12px 24px; text-decoration: none;">
                        Reportar tu primer incidente
                    </a>
                </div>
            }
        </div>
    }

    @if (showRatingModal)
    {
        <div class="modal-overlay" @onclick="CloseRatingModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Calificar Servicio</h3>
                <div style="margin:20px 0; display:flex; gap:8px; justify-content:center">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var rating = i;
                        <button class="star-btn" @onclick="() => selectedRating = rating">
                            <span style="font-size:32px; color:@(selectedRating >= rating ? "var(--color-warning)" : "var(--text-gray)")">⭐</span>
                        </button>
                    }
                </div>
                <textarea @bind="feedbackComment" placeholder="Comentarios adicionales (opcional)" rows="3" style="width:100%; padding:12px; border:1px solid var(--border-color); border-radius:8px; margin-bottom:16px"></textarea>
                <div style="display:flex; gap:12px; justify-content:flex-end">
                    <button class="btn-secondary" @onclick="CloseRatingModal">Cancelar</button>
                    <button class="btn-primary" @onclick="SubmitRating" disabled="@(selectedRating == 0)">Enviar</button>
                </div>
            </div>
        </div>
    }
</div>

@inject GestionIncidentes.Web.Services.AuthService AuthService

@code {
    private List<TicketResponseDto> myReports = new();
    private bool loading = true;
    private bool showRatingModal = false;
    private Guid? ratingTicketId = null;
    private int selectedRating = 0;
    private string feedbackComment = "";
    private string debugInfo = "";
    private string currentUserName = "";
    private string currentUserEmail = "";

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("[UsuarioDashboard] OnInitializedAsync - Componente inicializado");
        currentUserName = await AuthService.GetCurrentUserNameAsync() ?? "Desconocido";
        currentUserEmail = await AuthService.GetCurrentUserEmailAsync() ?? "No disponible";
        Console.WriteLine($"[UsuarioDashboard] Usuario actual: {currentUserName} ({currentUserEmail})");
        await LoadReportsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        Console.WriteLine("[UsuarioDashboard] OnParametersSetAsync - Recargando datos");
        await LoadReportsAsync();
    }

    private async Task RefreshData()
    {
        Console.WriteLine("[UsuarioDashboard] RefreshData - Usuario solicitó recarga manual");
        await LoadReportsAsync();
        StateHasChanged();
    }

    private async Task LoadReportsAsync()
    {
        loading = true;
        StateHasChanged(); // Forzar actualización de UI
        
        try
        {
            Console.WriteLine("[UsuarioDashboard] Iniciando carga de reportes...");
            
            // Agregar un pequeño delay para asegurar que la BD esté actualizada
            await Task.Delay(100);
            
            myReports = await ReportService.GetMyReportsAsync() ?? new List<TicketResponseDto>();
            Console.WriteLine($"[UsuarioDashboard] Reportes cargados: {myReports.Count}");
            
            if (myReports.Count == 0)
            {
                Console.WriteLine("[UsuarioDashboard] ADVERTENCIA: No se encontraron reportes para este usuario");
            }
            else
            {
                foreach (var report in myReports)
                {
                    Console.WriteLine($"[UsuarioDashboard] Reporte: {report.TicketNumber} - {report.Title} - Status: {report.Status}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UsuarioDashboard] ERROR loading reports: {ex.Message}");
            Console.WriteLine($"[UsuarioDashboard] Stack: {ex.StackTrace}");
            myReports = new List<TicketResponseDto>();
        }
        finally
        {
            loading = false;
            StateHasChanged(); // Forzar actualización de UI después de cargar
        }
    }

    private void ShowRatingModal(Guid ticketId)
    {
        ratingTicketId = ticketId;
        selectedRating = 0;
        feedbackComment = "";
        showRatingModal = true;
    }

    private void CloseRatingModal()
    {
        showRatingModal = false;
        ratingTicketId = null;
    }

    private async Task SubmitRating()
    {
        if (ratingTicketId == null || selectedRating == 0) return;
        
        try
        {
            var dto = new RateTicketDto(selectedRating, feedbackComment);
            await ReportService.RateTicketAsync(ratingTicketId.Value, dto);
            await LoadReportsAsync();
            CloseRatingModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting rating: {ex.Message}");
        }
    }

    private string GetStatusClass(string status) => status?.ToLower() switch
    {
        "resuelto" => "baja",
        "en proceso" => "media",
        "en progreso" => "media",
        "pendiente" => "alta",
        _ => "media"
    };

    private string GetDisplayStatus(string status)
    {
        if (string.IsNullOrEmpty(status))
            return "Pendiente";
        
        return status;
    }
}

<style>
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-content {
    background: white;
    padding: 24px;
    border-radius: 12px;
    max-width: 500px;
    width: 90%;
}

.star-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
}

.btn-small {
    padding: 4px 12px;
    font-size: 12px;
    border: 1px solid var(--color-primary);
    background: white;
    color: var(--color-primary);
    border-radius: 6px;
    cursor: pointer;
}

.btn-small:hover {
    background: var(--color-primary);
    color: white;
}
</style>

@page "/admin/nuevo-incidente"
@layout AdminLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject MediatR.IMediator Mediator
@inject IJSRuntime JSRuntime
@using GestionIncidentes.Application.Features.Incidents.Commands

<link rel="stylesheet" href="/css/pages.css" />
<link rel="stylesheet" href="/css/usuario.css" />

<div class="report-form">
  <div class="page-header" style="text-align:center; margin-bottom:32px">
    <div style="width:56px; height:56px; background:#eff6ff; border-radius:12px; display:flex; align-items:center; justify-content:center; margin:0 auto 16px">
      <span class="material-icons" style="font-size:32px; color:var(--color-primary)">error_outline</span>
    </div>
    <h1 class="page-title">Crear Nuevo Incidente</h1>
    <p class="page-subtitle">Completa los pasos para registrar un nuevo problema técnico</p>
  </div>

  <div class="form-section @(titulo != "" ? "active" : "")">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px">
      <div class="step-number">1</div>
      <div>
        <div class="section-title">Información Básica</div>
        <div class="section-desc">Título y descripción del problema</div>
      </div>
    </div>
    <div style="display:flex; flex-direction:column; gap:16px">
      <div>
        <label style="display:block; margin-bottom:8px; font-weight:500">Título del Incidente *</label>
        <input type="text" @bind="titulo" placeholder="Ej: Sin conectividad en Aula 301" 
          class="form-control" style="width:100%; padding:12px; border:2px solid var(--border-color); border-radius:10px" />
      </div>
      <div>
        <label style="display:block; margin-bottom:8px; font-weight:500">Descripción Detallada *</label>
        <textarea @bind="descripcion" @bind:event="oninput" rows="5" 
          placeholder="Describe el problema con el mayor detalle posible..." 
          class="form-control" style="width:100%; padding:12px; border:2px solid var(--border-color); border-radius:10px; resize:vertical"></textarea>
        <p style="font-size:12px; color:var(--text-gray); margin-top:4px">@descripcion.Length/1000 caracteres</p>
      </div>
    </div>
  </div>

  <div class="form-section @(categoria != "" ? "active" : "")">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px">
      <div class="step-number">2</div>
      <div>
        <div class="section-title">Categoría y Prioridad</div>
        <div class="section-desc">Clasifica el tipo de problema</div>
      </div>
    </div>
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:16px">
      <div class="choice-card @(categoria == "hardware" ? "selected" : "")" @onclick='() => categoria = "hardware"' style="padding:16px; cursor:pointer">
        <span class="material-icons" style="font-size:24px; color:var(--color-primary)">monitor</span>
        <div style="font-size:14px; margin-top:8px; font-weight:500">Hardware</div>
      </div>
      <div class="choice-card @(categoria == "software" ? "selected" : "")" @onclick='() => categoria = "software"' style="padding:16px; cursor:pointer">
        <span class="material-icons" style="font-size:24px; color:var(--color-primary)">apps</span>
        <div style="font-size:14px; margin-top:8px; font-weight:500">Software</div>
      </div>
      <div class="choice-card @(categoria == "connectivity" ? "selected" : "")" @onclick='() => categoria = "connectivity"' style="padding:16px; cursor:pointer">
        <span class="material-icons" style="font-size:24px; color:var(--color-primary)">wifi</span>
        <div style="font-size:14px; margin-top:8px; font-weight:500">Conectividad</div>
      </div>
      <div class="choice-card @(categoria == "security" ? "selected" : "")" @onclick='() => categoria = "security"' style="padding:16px; cursor:pointer">
        <span class="material-icons" style="font-size:24px; color:var(--color-primary)">security</span>
        <div style="font-size:14px; margin-top:8px; font-weight:500">Seguridad</div>
      </div>
    </div>
    <div>
      <label style="display:block; margin-bottom:8px; font-weight:500">Nivel de Prioridad *</label>
      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px">
        <div class="choice-card @(prioridad == "critical" ? "selected" : "")" @onclick='() => prioridad = "critical"' style="padding:12px; cursor:pointer">
          <div style="font-size:24px">🔴</div>
          <div style="font-size:13px; margin-top:4px; font-weight:500">Crítica</div>
        </div>
        <div class="choice-card @(prioridad == "high" ? "selected" : "")" @onclick='() => prioridad = "high"' style="padding:12px; cursor:pointer">
          <div style="font-size:24px">🟠</div>
          <div style="font-size:13px; margin-top:4px; font-weight:500">Alta</div>
        </div>
        <div class="choice-card @(prioridad == "medium" ? "selected" : "")" @onclick='() => prioridad = "medium"' style="padding:12px; cursor:pointer">
          <div style="font-size:24px">🟡</div>
          <div style="font-size:13px; margin-top:4px; font-weight:500">Media</div>
        </div>
        <div class="choice-card @(prioridad == "low" ? "selected" : "")" @onclick='() => prioridad = "low"' style="padding:12px; cursor:pointer">
          <div style="font-size:24px">🟢</div>
          <div style="font-size:13px; margin-top:4px; font-weight:500">Baja</div>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section @(tipoAfectacion != "" ? "active" : "")">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px">
      <div class="step-number">3</div>
      <div>
        <div class="section-title">Ubicación y Alcance</div>
        <div class="section-desc">¿Dónde ocurre el problema y a cuántos afecta?</div>
      </div>
    </div>
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:16px">
      <div class="choice-card @(tipoAfectacion == "user" ? "selected" : "")" @onclick='() => tipoAfectacion = "user"' style="padding:16px; cursor:pointer">
        <span class="material-icons" style="font-size:24px; color:var(--color-primary)">person</span>
        <div style="font-size:13px; margin-top:8px; font-weight:500">Usuario Individual</div>
      </div>
      <div class="choice-card @(tipoAfectacion == "classroom" ? "selected" : "")" @onclick='() => tipoAfectacion = "classroom"' style="padding:16px; cursor:pointer">
        <span class="material-icons" style="font-size:24px; color:var(--color-primary)">meeting_room</span>
        <div style="font-size:13px; margin-top:8px; font-weight:500">Aula/Laboratorio</div>
      </div>
      <div class="choice-card @(tipoAfectacion == "building" ? "selected" : "")" @onclick='() => tipoAfectacion = "building"' style="padding:16px; cursor:pointer">
        <span class="material-icons" style="font-size:24px; color:var(--color-primary)">apartment</span>
        <div style="font-size:13px; margin-top:8px; font-weight:500">Edificio Completo</div>
      </div>
      <div class="choice-card @(tipoAfectacion == "campus" ? "selected" : "")" @onclick='() => tipoAfectacion = "campus"' style="padding:16px; cursor:pointer">
        <span class="material-icons" style="font-size:24px; color:var(--color-primary)">domain</span>
        <div style="font-size:13px; margin-top:8px; font-weight:500">Campus</div>
      </div>
    </div>
    <div>
      <label style="display:block; margin-bottom:8px; font-weight:500">Detalle de Ubicación *</label>
      <input type="text" @bind="ubicacionDetalle" placeholder="Ej: Edificio A, Piso 3, Laboratorio 5" 
        class="form-control" style="width:100%; padding:12px; border:2px solid var(--border-color); border-radius:10px" />
    </div>
  </div>

  <div style="display:flex; justify-content:center; gap:16px; margin-top:32px">
    <button class="btn-cancel" @onclick="Cancelar" style="padding:12px 24px; border:none; background:transparent; color:var(--text-gray); cursor:pointer; border-radius:8px">
      Cancelar
    </button>
    <button class="btn-submit" disabled="@(!IsFormValid())" @onclick="CrearTicket" style="padding:12px 32px; background:var(--color-primary); color:white; border:none; border-radius:8px; font-weight:500; cursor:pointer; display:flex; align-items:center; gap:8px">
      <span class="material-icons" style="font-size:18px">save</span>
      Crear Incidente
    </button>
  </div>
</div>

<style>
@@keyframes slideDown {
  from { opacity:0; transform:translateY(-10px); }
  to { opacity:1; transform:translateY(0); }
}
</style>

@code {
  private string titulo = "";
  private string categoria = "";
  private string prioridad = "";
  private string tipoAfectacion = "";
  private string ubicacionDetalle = "";
  private string descripcion = "";

  private bool IsFormValid()
  {
    return !string.IsNullOrWhiteSpace(titulo) &&
           !string.IsNullOrWhiteSpace(descripcion) &&
           !string.IsNullOrWhiteSpace(categoria) &&
           !string.IsNullOrWhiteSpace(prioridad) &&
           !string.IsNullOrWhiteSpace(tipoAfectacion) &&
           !string.IsNullOrWhiteSpace(ubicacionDetalle);
  }

  private async Task CrearTicket()
  {
    if (!IsFormValid()) return;

    try
    {
      // Construir descripción completa con todos los detalles
      var fullDescription = $"**Categoría:** {GetCategoriaName(categoria)}\n";
      fullDescription += $"**Prioridad:** {GetPrioridadName(prioridad)}\n";
      fullDescription += $"**Tipo de Afectación:** {GetAfectacionName(tipoAfectacion)}\n";
      fullDescription += $"**Ubicación:** {ubicacionDetalle}\n\n";
      fullDescription += $"**Descripción del Problema:**\n{descripcion}";

      // Crear INCIDENTE usando MediatR
      var command = new CreateIncidentCommand(
        Title: titulo,
        Description: fullDescription
      );

      var incidentId = await Mediator.Send(command);
      
      // Mostrar notificación de éxito
      await JSRuntime.InvokeVoidAsync("alert", $"✅ Incidente creado exitosamente.\n\nID del incidente: {incidentId}\n\nAhora puede asignarlo a un técnico desde la lista de incidentes.");
      
      // Redirigir a la lista de incidentes
      Navigation.NavigateTo("/admin/incidentes", forceLoad: true);
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error creating incident: {ex.Message}");
      await JSRuntime.InvokeVoidAsync("alert", "❌ Error al crear el incidente. Por favor intenta nuevamente.");
    }
  }

  private void Cancelar()
  {
    Navigation.NavigateTo("/admin/incidentes", forceLoad: true);
  }

  private string GetCategoriaName(string cat) => cat switch
  {
    "hardware" => "Hardware",
    "software" => "Software",
    "connectivity" => "Conectividad",
    "security" => "Seguridad",
    _ => cat
  };

  private string GetPrioridadName(string prio) => prio switch
  {
    "critical" => "🔴 Crítica",
    "high" => "🟠 Alta",
    "medium" => "🟡 Media",
    "low" => "🟢 Baja",
    _ => prio
  };

  private string GetAfectacionName(string afect) => afect switch
  {
    "user" => "Usuario Individual",
    "classroom" => "Aula/Laboratorio",
    "building" => "Edificio Completo",
    "campus" => "Campus",
    _ => afect
  };
}

  {
    Navigation.NavigateTo("/admin/incidentes", forceLoad: true);
  }

  public class ArticuloSugerido
  {
    public int Id { get; set; }
    public string Titulo { get; set; } = "";
    public string Categoria { get; set; } = "";
    public int Relevancia { get; set; }
  }
}

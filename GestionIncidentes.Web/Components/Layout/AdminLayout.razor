@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject GestionIncidentes.Web.Services.AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http

<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
<link rel="stylesheet" href="/css/theme.css" />
<link rel="stylesheet" href="/css/admin-layout.css" />

<div class="admin-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <button class="menu-toggle" @onclick="ToggleSidebar">
                <span class="material-icons">menu</span>
            </button>
            <div class="brand">
                <span class="brand-icon">SI</span>
                <span class="brand-text">Sistema de Incidentes - Universidad</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <NavLink class="nav-item" href="/admin/dashboard" Match="NavLinkMatch.All">
                <span class="material-icons">dashboard</span>
                <span class="nav-text">Dashboard</span>
            </NavLink>

            <NavLink class="nav-item" href="/admin/incidentes">
                <span class="material-icons">error_outline</span>
                <span class="nav-text">Incidentes</span>
            </NavLink>

            <NavLink class="nav-item" href="/admin/nuevo-incidente">
                <span class="material-icons">add</span>
                <span class="nav-text">Nuevo Incidente</span>
            </NavLink>

            <NavLink class="nav-item" href="/admin/historial">
                <span class="material-icons">history</span>
                <span class="nav-text">Historial</span>
            </NavLink>

            <NavLink class="nav-item" href="/admin/usuarios">
                <span class="material-icons">people</span>
                <span class="nav-text">Usuarios</span>
            </NavLink>

            <NavLink class="nav-item" href="/admin/base-conocimientos">
                <span class="material-icons">menu_book</span>
                <span class="nav-text">Base de Conocimientos</span>
            </NavLink>

            <NavLink class="nav-item" href="/admin/configuracion">
                <span class="material-icons">settings</span>
                <span class="nav-text">Configuración</span>
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            <div class="system-status">
                <h4 class="status-title">ESTADO DEL SISTEMA</h4>
                <div class="status-item">
                    <span class="status-label">T�cnicos activos</span>
                    <span class="status-value">8</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Tiempo promedio</span>
                    <span class="status-value">2.5h</span>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="navbar-content">
                <div class="navbar-left">
                    <!-- Breadcrumb o t�tulo aqu� si lo necesitas -->
                </div>
                <div class="navbar-right">
                    <!-- Notificaciones -->
                    <button class="icon-button" @onclick="ToggleNotifications">
                        <span class="material-icons">notifications</span>
                        <span class="badge">3</span>
                    </button>

                    <!-- Usuario - Click para cerrar sesión -->
                    <a href="/LogoutPage" 
                       style="display: flex; align-items: center; gap: 12px; padding: 8px 16px; 
                              background: white; border: 1px solid #e0e0e0; border-radius: 8px; 
                              cursor: pointer; transition: all 0.3s; text-decoration: none;">
                        <div class="user-avatar" style="width: 40px; height: 40px; border-radius: 50%; 
                                                         background: #1976d2; display: flex; align-items: center; 
                                                         justify-content: center;">
                            <span class="material-icons" style="color: white; font-size: 24px;">person</span>
                        </div>
                        <div class="user-info" style="display: flex; flex-direction: column; align-items: flex-start;">
                            <span class="user-name" style="font-weight: 600; font-size: 14px; color: #333;">@currentUserName</span>
                            <span class="user-role" style="font-size: 12px; color: #666;">@currentUserRole</span>
                        </div>
                        <span class="material-icons" style="color: #999; font-size: 20px;">logout</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="page-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool sidebarCollapsed = false;
    private bool showNotifications = false;
    private string currentUserName = "Cargando...";
    private string currentUserRole = "";

    protected override async Task OnInitializedAsync()
    {
        currentUserName = await AuthService.GetCurrentUserNameAsync() ?? "Usuario";
        currentUserRole = await AuthService.GetCurrentUserRoleAsync() ?? "Admin";
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private void ToggleNotifications()
    {
        showNotifications = !showNotifications;
    }

    private void HandleLogout()
    {
        Console.WriteLine("========================================");
        Console.WriteLine("[AdminLayout] HandleLogout - INICIADO");
        Console.WriteLine("[AdminLayout] Botón de logout clickeado");
        Console.WriteLine("========================================");
        
        try
        {
            Console.WriteLine("[AdminLayout] Intentando navegar a /LogoutPage");
            Console.WriteLine($"[AdminLayout] URL actual: {Navigation.Uri}");
            
            Navigation.NavigateTo("/LogoutPage", forceLoad: true);
            
            Console.WriteLine("[AdminLayout] NavigateTo ejecutado exitosamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminLayout] ERROR en HandleLogout: {ex.GetType().Name}");
            Console.WriteLine($"[AdminLayout] Mensaje: {ex.Message}");
            Console.WriteLine($"[AdminLayout] StackTrace: {ex.StackTrace}");
        }
        
        Console.WriteLine("[AdminLayout] HandleLogout - FINALIZADO");
    }
}
